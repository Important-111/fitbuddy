/* ===== 飞特八弟 · 暗黑力量（Dark Athletic）设计系统 ===== */
page {
  /* 品牌色：电光黄绿 */
  --primary: #CCFF00;
  --primary-light: rgba(204, 255, 0, 0.12);
  --primary-hover: #B8E600;
  --primary-soft: rgba(204, 255, 0, 0.10);
  --accent: #FF3D00;
  --accent-light: rgba(255, 61, 0, 0.18);

  /* 背景 / 卡片：纯黑底 + 半透玻璃态 */
  --bg: #0A0A0A;
  --card: rgba(255, 255, 255, 0.06);
  --paper: #1A1A1A;

  /* 文字：白 / 浅灰 / 中灰 */
  --text-primary: #FFFFFF;
  --text-secondary: #B0B0B0;
  --text-tertiary: #808080;

  /* 线条 / 状态 */
  --border: rgba(255, 255, 255, 0.08);
  --success: #CCFF00;
  --warning: #FF3D00;
  --danger: #FF3D00;

  /* 圆角 / 阴影（暗黑风：绿色辉光） */
  --radius-lg: 22px;
  --radius-md: 18px;
  --radius-sm: 12px;
  --shadow-card: 0 4px 18px rgba(0, 0, 0, 0.40);
  --shadow-card-lg: 0 8px 28px rgba(204, 255, 0, 0.18);

  margin: 0; padding: 0;
  box-sizing: border-box;
  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* ===== 通用容器 ===== */
.page-container {
  min-height: 100vh;
  background: var(--bg);
  position: relative;
  overflow-x: hidden;
  padding-bottom: calc(76px + env(safe-area-inset-bottom));
}
.page-container.no-tab {
  padding-bottom: 0;
}

/* ===== 顶部导航 ===== */
.top-bar {
  padding: 14px 20px;
  padding-top: calc(14px + constant(safe-area-inset-top));
  padding-top: calc(14px + env(safe-area-inset-top));
  display: flex;
  align-items: center;
  gap: 12px;
  background: var(--card);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 10;
}
.top-bar.justify-between { justify-content: space-between; }
.top-bar-title { font-size: 18px; font-weight: 700; color: var(--text-primary); letter-spacing: 0.5px; }
.btn-back {
  width: 36px; height: 36px; border: none; background: none;
  display: flex; align-items: center; justify-content: center;
  border-radius: 10px;
  color: var(--text-primary);
}

/* ===== 杂志风通用排版 ===== */
.mag-h1 {
  font-size: 32px;
  font-weight: 800;
  line-height: 1.18;
  color: var(--text-primary);
  letter-spacing: 0.5px;
}
.mag-h1 .accent { color: var(--primary); }
.mag-sub {
  font-size: 13px;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-top: 8px;
}
.mag-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  font-weight: 600;
  color: var(--primary);
  background: var(--primary-soft);
  padding: 4px 12px;
  border-radius: 20px;
  margin-bottom: 12px;
}

/* ===== 按钮 ===== */
.btn-primary {
  width: 100%; height: 52px; background: var(--primary); color: #FFF;
  border: none; border-radius: var(--radius-sm); font-size: 16px; font-weight: 700;
  font-family: inherit;
  box-shadow: 0 6px 18px rgba(204, 255, 0, 0.22);
}
.btn-primary:active { opacity: 0.92; }

.btn-secondary {
  flex: 1; height: 46px; background: var(--bg); color: var(--text-primary);
  border: 1px solid var(--border); border-radius: var(--radius-sm); font-size: 15px;
  font-family: inherit;
}
.btn-outline {
  flex: 1; height: 50px; border: 2px solid var(--primary); border-radius: var(--radius-sm);
  background: var(--card); color: var(--primary); font-size: 15px; font-weight: 700;
  font-family: inherit;
}
.btn-confirm {
  flex: 1; height: 46px; background: var(--primary); color: #FFF;
  border: none; border-radius: var(--radius-sm); font-size: 15px; font-weight: 700;
  font-family: inherit;
}
.btn-start {
  width: 100%; height: 48px; background: var(--primary); color: #FFF;
  border: none; border-radius: var(--radius-sm); font-size: 15px; font-weight: 700;
  font-family: inherit;
  box-shadow: 0 6px 18px rgba(204, 255, 0, 0.22);
}
.btn-submit {
  width: 100%; height: 50px; background: var(--primary); color: #FFF;
  border: none; border-radius: var(--radius-sm); font-size: 16px; font-weight: 700;
  font-family: inherit;
}
.btn-sm {
  height: 36px; padding: 0 18px; font-size: 12px; border-radius: 10px; font-weight: 600;
}

/* ===== 区块标题 ===== */
.section-title {
  font-size: 17px; font-weight: 700; color: var(--text-primary);
  margin-bottom: 14px; display: flex; align-items: center; gap: 9px;
  letter-spacing: 0.3px;
}
.section-title::before {
  content: ''; width: 4px; height: 16px; background: var(--primary); border-radius: 2px;
  flex-shrink: 0;
}
.section-header {
  display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;
}
.section-title-inline { font-size: 21px; font-weight: 800; color: var(--text-primary); letter-spacing: 0.3px; }
.section-desc { font-size: 13px; color: var(--text-secondary); margin-bottom: 20px; line-height: 1.6; }
.section-link { font-size: 13px; color: var(--primary); font-weight: 600; }

/* ===== 表单 ===== */
.form-section { padding: 20px 24px; }
.form-group { margin-bottom: 20px; }
.form-label { font-size: 14px; font-weight: 700; color: var(--text-primary); margin-bottom: 8px; display: block; }
.form-input {
  width: 100%; height: 50px; border: 1.5px solid var(--border); border-radius: var(--radius-sm);
  padding: 0 14px; font-size: 15px; color: var(--text-primary); background: var(--card);
  font-family: inherit; box-sizing: border-box;
}
.form-input:focus { border-color: var(--primary); }
.form-row { display: flex; gap: 12px; }
.form-row .form-group { flex: 1; }
.form-tip { font-size: 12px; color: var(--text-secondary); margin-top: 6px; line-height: 1.5; }

.gender-group { display: flex; gap: 12px; }
.gender-option {
  flex: 1; height: 50px; border: 1.5px solid var(--border); border-radius: var(--radius-sm);
  display: flex; align-items: center; justify-content: center; gap: 8px;
  font-size: 15px; color: var(--text-secondary);
  background: var(--card);
}
.gender-option.selected { border-color: var(--primary); color: var(--primary); background: var(--primary-soft); font-weight: 600; }

.option-group { display: flex; flex-wrap: wrap; gap: 10px; }
.option-chip {
  padding: 11px 18px; border: 1.5px solid var(--border); border-radius: 14px;
  font-size: 14px; color: var(--text-secondary);
  background: var(--card);
}
.option-chip.selected { border-color: var(--primary); color: var(--primary); background: var(--primary-soft); font-weight: 600; }
.equip-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.equip-chip {
  padding: 14px; border: 1.5px solid var(--border); border-radius: var(--radius-sm);
  font-size: 13px; color: var(--text-secondary);
  background: var(--card); text-align: center;
}
.equip-chip.selected { border-color: var(--primary); color: var(--primary); background: var(--primary-soft); font-weight: 600; }
.days-group { display: flex; gap: 8px; flex-wrap: wrap; }
.day-chip {
  width: 44px; height: 44px; border: 1.5px solid var(--border); border-radius: 12px;
  display: flex; align-items: center; justify-content: center;
  font-size: 15px; font-weight: 600; color: var(--text-secondary);
  background: var(--card);
}
.day-chip.selected { border-color: var(--primary); color: #FFF; background: var(--primary); }

/* ===== 底部 Tab（旧版占位，实际由 tab-bar 组件渲染） ===== */
.bottom-tab {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: var(--card); border-top: 1px solid var(--border);
  display: flex; padding: 6px 0 12px; z-index: 100;
}
.tab-item {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  padding: 6px 0; color: var(--text-secondary); font-size: 10px;
}
.tab-item.active { color: var(--primary); }
.tab-icon { width: 22px; height: 22px; margin-bottom: 3px; }

/* ===== Toast ===== */
.toast-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  display: flex; align-items: center; justify-content: center;
  pointer-events: none; z-index: 9999;
}
.toast-content {
  background: rgba(0, 0, 0, 0.92); color: #FFF; border: 1px solid var(--border);
  padding: 14px 22px; border-radius: 14px; font-size: 14px;
  max-width: 80%; text-align: center;
}

/* ===== 安全提醒（暗黑警告色） ===== */
.health-warning {
  background: var(--accent-light); border: 1px solid rgba(255, 61, 0, 0.45); border-radius: 14px;
  padding: 12px 14px; margin: 0 20px 18px;
}
.health-warning text { font-size: 12px; color: #FF8A65; line-height: 1.6; }

/* ===== 统一 Hero 卡（珊瑚橙实底 + 白字） ===== */
.hero-card {
  margin: 16px 20px;
  border-radius: var(--radius-lg);
  padding: 24px;
  background: var(--primary);
  color: #FFF;
  position: relative;
  overflow: hidden;
  box-shadow: var(--shadow-card-lg);
}

/* ===== 仪表盘 ===== */
.top-greeting { font-size: 13px; color: var(--text-secondary); }
.top-name { font-size: 19px; font-weight: 800; color: var(--text-primary); margin-top: 2px; }
.top-avatar {
  width: 44px; height: 44px; border-radius: 50%;
  background: var(--primary-soft); color: var(--primary);
  display: flex; align-items: center; justify-content: center; font-size: 20px;
}
.streak-banner {
  margin: 16px 20px; border-radius: var(--radius-lg); padding: 24px;
  background: var(--primary); color: #FFF; position: relative; overflow: hidden;
  box-shadow: var(--shadow-card-lg);
}
.streak-header { display: flex; align-items: center; justify-content: space-between; }
.streak-fire { font-size: 34px; }
.streak-days { font-size: 38px; font-weight: 800; line-height: 1; }
.streak-label { font-size: 13px; opacity: 0.9; }
.streak-stats { display: flex; gap: 20px; margin-top: 16px; }
.streak-stat { text-align: center; }
.streak-stat-val { font-size: 17px; font-weight: 800; }
.streak-stat-lbl { font-size: 11px; opacity: 0.85; }

.today-section { padding: 0 20px; margin-bottom: 22px; }
.today-card { background: var(--card); border-radius: var(--radius-md); padding: 22px; border: 1px solid var(--border); box-shadow: var(--shadow-card); }
.today-card-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; }
.today-day { font-size: 16px; font-weight: 700; color: var(--text-primary); }
.today-type { font-size: 12px; color: var(--primary); background: var(--primary-soft); padding: 5px 12px; border-radius: 20px; font-weight: 700; }
.today-goal { font-size: 13px; color: var(--text-secondary); margin-bottom: 16px; line-height: 1.6; }
.today-meta { display: flex; gap: 20px; margin-bottom: 18px; }
.today-meta-item { text-align: center; }
.today-meta-val { font-size: 18px; font-weight: 800; color: var(--text-primary); }
.today-meta-lbl { font-size: 11px; color: var(--text-secondary); }

.quick-actions { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 12px; padding: 0 20px; margin-bottom: 22px; }
.quick-action { background: var(--card); border-radius: var(--radius-md); padding: 16px 8px; text-align: center; border: 1px solid var(--border); box-shadow: var(--shadow-card); }
.quick-action-icon { font-size: 26px; margin-bottom: 8px; }
.quick-action-text { font-size: 11px; color: var(--text-secondary); font-weight: 600; }

.progress-section { padding: 0 20px; margin-bottom: 22px; }
.progress-card { background: var(--card); border-radius: var(--radius-md); padding: 20px; border: 1px solid var(--border); box-shadow: var(--shadow-card); }

/* ===== 训练目标页 ===== */
.goal-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.goal-card { padding: 18px 14px; border: 1.5px solid var(--border); border-radius: var(--radius-md); background: var(--card); text-align: center; box-shadow: var(--shadow-card); }
.goal-card.selected { border-color: var(--primary); background: var(--primary-soft); }
.goal-icon { font-size: 30px; margin-bottom: 10px; }
.goal-name { font-size: 14px; font-weight: 700; color: var(--text-primary); }

/* ===== 训练计划 ===== */
.month-goal-card {
  margin: 16px 20px; border-radius: var(--radius-lg); padding: 24px;
  background: var(--primary); color: #FFF; position: relative; overflow: hidden;
  box-shadow: var(--shadow-card-lg);
}
.month-goal-title { font-size: 14px; opacity: 0.92; font-weight: 600; }
.month-goal-main { font-size: 23px; font-weight: 800; margin: 8px 0; line-height: 1.4; }
.month-goal-sub { font-size: 13px; opacity: 0.88; }
.week-tabs { display: flex; padding: 0 20px; gap: 8px; margin-bottom: 18px; overflow-x: auto; }
.week-tab { padding: 9px 18px; border-radius: 22px; font-size: 13px; border: 1.5px solid var(--border); background: var(--card); color: var(--text-secondary); white-space: nowrap; font-weight: 600; }
.week-tab.active { background: var(--primary); color: #FFF; border-color: var(--primary); }
.week-schedule { padding: 0 20px; }
.day-card {
  background: var(--card); border-radius: var(--radius-md); padding: 18px; margin-bottom: 12px;
  border: 1px solid var(--border); box-shadow: var(--shadow-card);
  display: flex; align-items: center; gap: 14px; position: relative;
}
.day-card::before { content: ''; position: absolute; left: 0; top: 10px; bottom: 10px; width: 4px; border-radius: 0 4px 4px 0; background: transparent; }
.day-card.today { border-color: var(--primary); background: var(--primary-soft); }
.day-card.today::before { background: var(--primary); }
.day-card.done .day-num { background: var(--success); color: #FFF; }
.day-card.rest .day-num { background: rgba(255,255,255,0.06); color: var(--text-secondary); }
.day-num { width: 46px; height: 46px; border-radius: 14px; display: flex; flex-direction: column; align-items: center; justify-content: center; background: var(--paper); color: var(--text-secondary); flex-shrink: 0; }
.day-card.today .day-num { background: var(--primary); color: #FFF; }
.day-num-name { font-size: 13px; font-weight: 700; }
.day-num-date { font-size: 10px; }
.day-info { flex: 1; }
.day-type { font-size: 15px; font-weight: 700; color: var(--text-primary); margin-bottom: 4px; }
.day-desc { font-size: 12px; color: var(--text-secondary); }
.day-status { padding: 5px 12px; border-radius: 20px; font-size: 11px; font-weight: 700; }
.status-todo { background: var(--primary-soft); color: var(--primary); }
.status-done { background: rgba(22,160,107,0.12); color: var(--success); }

/* ===== 每日训练 ===== */
.workout-header { margin: 16px 20px; border-radius: var(--radius-lg); padding: 24px; background: var(--primary); color: #FFF; position: relative; overflow: hidden; box-shadow: var(--shadow-card-lg); }
.workout-header h2 { font-size: 22px; font-weight: 800; }
.workout-header p { font-size: 13px; opacity: 0.9; margin-top: 6px; }
.workout-meta { display: flex; gap: 20px; margin-top: 16px; }
.workout-meta-item { text-align: center; }
.workout-meta-val { font-size: 19px; font-weight: 800; }
.workout-meta-lbl { font-size: 11px; opacity: 0.85; }
.phase-section { padding: 0 20px; margin-bottom: 18px; }
.phase-title { font-size: 16px; font-weight: 700; color: var(--text-primary); margin-bottom: 12px; display: flex; align-items: center; gap: 8px; }
.exercise-card { background: var(--card); border-radius: var(--radius-md); padding: 18px; margin-bottom: 12px; border: 1px solid var(--border); box-shadow: var(--shadow-card); display: flex; gap: 14px; align-items: flex-start; }
.exercise-card.completed { border-color: var(--success); }
.exercise-num { width: 38px; height: 38px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 800; flex-shrink: 0; background: var(--primary-soft); color: var(--primary); }
.exercise-info { flex: 1; }
.exercise-name { font-size: 15px; font-weight: 700; color: var(--text-primary); margin-bottom: 5px; }
.exercise-detail { font-size: 13px; color: var(--text-secondary); line-height: 1.6; }

/* ===== 动作说明 ===== */
.exercise-hero { margin: 16px 20px; border-radius: var(--radius-lg); height: 184px; display: flex; align-items: center; justify-content: center; color: #FFF; font-size: 50px; background: var(--primary); position: relative; overflow: hidden; box-shadow: var(--shadow-card-lg); }
.exercise-main-name { font-size: 24px; font-weight: 800; color: var(--text-primary); }
.exercise-tags { display: flex; gap: 8px; margin-top: 12px; flex-wrap: wrap; }
.exercise-tag { padding: 6px 14px; border-radius: 20px; font-size: 12px; font-weight: 600; background: var(--primary-soft); color: var(--primary); }
.info-section { padding: 0 20px; margin-bottom: 18px; }
.info-title { font-size: 16px; font-weight: 700; color: var(--text-primary); margin-bottom: 12px; display: flex; align-items: center; gap: 8px; }
.info-card { background: var(--card); border-radius: var(--radius-md); padding: 18px; border: 1px solid var(--border); box-shadow: var(--shadow-card); margin-bottom: 10px; }
.info-row { display: flex; justify-content: space-between; padding: 9px 0; border-bottom: 1px solid var(--border); }
.info-row:last-child { border-bottom: none; }

/* ===== 打卡 ===== */
.checkin-hero { margin: 16px 20px; border-radius: var(--radius-lg); padding: 26px; text-align: center; color: #FFF; background: var(--primary); position: relative; overflow: hidden; box-shadow: var(--shadow-card-lg); }
.checkin-hero-emoji { font-size: 50px; margin-bottom: 10px; }
.checkin-hero h2 { font-size: 22px; font-weight: 800; }
.checkin-hero p { font-size: 13px; opacity: 0.9; margin-top: 6px; }
.rating-section { padding: 0 20px; margin-bottom: 18px; }
.rating-label { font-size: 16px; font-weight: 700; color: var(--text-primary); margin-bottom: 12px; }
.rating-stars { display: flex; gap: 10px; justify-content: center; }
.rating-star { width: 50px; height: 50px; border-radius: 14px; border: 1.5px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 22px; background: var(--card); }
.rating-star.selected { border-color: var(--primary); background: var(--primary-soft); }

/* ===== 进度追踪 ===== */
.overview-cards { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; padding: 16px 20px; }
.overview-card { background: var(--card); border-radius: var(--radius-md); padding: 18px; border: 1px solid var(--border); box-shadow: var(--shadow-card); text-align: center; }
.overview-val { font-size: 25px; font-weight: 800; color: var(--primary); }
.overview-lbl { font-size: 12px; color: var(--text-secondary); margin-top: 6px; }
.chart-section { padding: 0 20px; margin-bottom: 18px; }
.chart-card { background: var(--card); border-radius: var(--radius-md); padding: 22px; border: 1px solid var(--border); box-shadow: var(--shadow-card); }
.chart-title { font-size: 16px; font-weight: 700; color: var(--text-primary); }
.chart-placeholder { height: 168px; background: var(--paper); border-radius: 14px; display: flex; align-items: flex-end; justify-content: space-around; padding: 22px 10px; border: 1px dashed var(--border); }
.chart-bar { width: 28px; border-radius: 8px 8px 0 0; background: var(--primary); }
.chart-bar.accent { background: var(--accent); }
.chart-bar-label { font-size: 10px; color: var(--text-secondary); }
.period-tabs { display: flex; gap: 8px; padding: 0 20px; margin-bottom: 18px; }
.period-tab { flex: 1; height: 40px; border-radius: 12px; border: 1.5px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 13px; background: var(--card); color: var(--text-secondary); font-weight: 600; }
.period-tab.active { background: var(--primary); color: #FFF; border-color: var(--primary); }
.filter-tabs { display: flex; gap: 8px; padding: 0 20px; margin-bottom: 14px; }
.filter-tab { padding: 7px 18px; border-radius: 20px; font-size: 12px; border: 1.5px solid var(--border); background: var(--card); color: var(--text-secondary); font-weight: 600; }
.filter-tab.active { background: var(--primary); color: #FFF; border-color: var(--primary); }

/* ===== 饮食 ===== */
.nutri-banner { margin: 16px 20px; border-radius: var(--radius-lg); padding: 24px; color: #FFF; background: var(--primary); position: relative; overflow: hidden; box-shadow: var(--shadow-card-lg); }
.nutri-banner h2 { font-size: 20px; font-weight: 800; margin-bottom: 14px; }
.nutri-row { display: flex; justify-content: space-around; }
.nutri-item { text-align: center; }
.nutri-val { font-size: 22px; font-weight: 800; }
.nutri-lbl { font-size: 11px; opacity: 0.88; margin-top: 4px; }
.meal-section { padding: 0 20px; margin-bottom: 18px; }
.meal-card { background: var(--card); border-radius: var(--radius-md); padding: 18px; margin-bottom: 12px; border: 1px solid var(--border); box-shadow: var(--shadow-card); }
.meal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
.meal-time { font-size: 14px; font-weight: 700; color: var(--text-primary); display: flex; align-items: center; gap: 8px; }
.meal-emoji { font-size: 18px; }
.meal-cal { font-size: 13px; color: var(--primary); font-weight: 700; background: var(--primary-soft); padding: 5px 12px; border-radius: 20px; }
.meal-items { display: flex; flex-wrap: wrap; gap: 8px; }
.meal-item { padding: 7px 14px; background: var(--paper); border-radius: 10px; font-size: 12px; color: var(--text-primary); }
.macro-section { padding: 0 20px; margin-bottom: 18px; }
.macro-card { background: var(--card); border-radius: var(--radius-md); padding: 20px; border: 1px solid var(--border); box-shadow: var(--shadow-card); }
.macro-row { display: flex; align-items: center; margin-bottom: 16px; }
.macro-row:last-child { margin-bottom: 0; }
.macro-label { min-width: 60px; font-size: 13px; color: var(--text-secondary); }
.macro-bar-wrap { flex: 1; height: 9px; background: var(--paper); border-radius: 5px; overflow: hidden; margin: 0 10px; }
.macro-bar { height: 100%; border-radius: 5px; }
.macro-bar.protein { background: var(--primary); }
.macro-bar.carb { background: var(--warning); }
.macro-bar.fat { background: var(--accent); }

/* ===== 个人中心 ===== */
.profile-header-card { margin: 16px 20px; border-radius: var(--radius-lg); padding: 26px; color: #FFF; background: var(--primary); display: flex; align-items: center; gap: 16px; position: relative; overflow: hidden; box-shadow: var(--shadow-card-lg); }
.profile-avatar { width: 66px; height: 66px; border-radius: 50%; background: rgba(255,255,255,0.22); display: flex; align-items: center; justify-content: center; font-size: 34px; flex-shrink: 0; }
.profile-name { font-size: 21px; font-weight: 800; }
.profile-goal { font-size: 13px; opacity: 0.88; margin-top: 4px; }
.profile-tags { display: flex; gap: 6px; margin-top: 10px; flex-wrap: wrap; }
.profile-tag { padding: 4px 12px; border-radius: 20px; font-size: 11px; background: rgba(255,255,255,0.22); font-weight: 600; }
.menu-section { padding: 0 20px; margin-bottom: 18px; }
.menu-card { background: var(--card); border-radius: var(--radius-md); border: 1px solid var(--border); box-shadow: var(--shadow-card); overflow: hidden; }
.menu-item { display: flex; align-items: center; padding: 16px; border-bottom: 1px solid var(--border); }
.menu-item:last-child { border-bottom: none; }
.menu-icon { width: 38px; height: 38px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 18px; margin-right: 14px; background: var(--primary-soft); }
.menu-text { flex: 1; }
.menu-title { font-size: 14px; font-weight: 600; color: var(--text-primary); }
.menu-desc { font-size: 11px; color: var(--text-secondary); }
.version-text { text-align: center; font-size: 11px; color: var(--text-secondary); margin-bottom: 16px; }

/* ===== Modal ===== */
.modal-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.70); z-index: 1000;
  display: flex; align-items: center; justify-content: center; padding: 24px;
}
.modal {
  background: var(--card); border-radius: var(--radius-lg); width: 100%; max-width: 380px;
  box-shadow: var(--shadow-card-lg);
}
.modal-header {
  padding: 22px 22px 14px; display: flex; align-items: center;
  justify-content: space-between; border-bottom: 1px solid var(--border);
}
.modal-title { font-size: 17px; font-weight: 800; color: var(--text-primary); }
.modal-close { width: 30px; height: 30px; border-radius: 50%; font-size: 16px; background: var(--paper); color: var(--text-secondary); }
.modal-body { padding: 22px; max-height: 60vh; overflow-y: auto; }
.modal-footer { padding: 14px 22px 22px; display: flex; gap: 12px; }

/* ===== 进度条 ===== */
.progress-bar-bg { height: 6px; background: var(--paper); border-radius: 3px; margin-top: 10px; }
.progress-bar-fill { height: 100%; background: var(--primary); border-radius: 3px; }
