.filter-tabs {
  display: flex;
  gap: 6px;
  padding: 0 20px;
  margin-bottom: 12px;
}
.filter-tab {
  padding: 6px 16px;
  border-radius: 16px;
  font-size: 12px;
  border: 1px solid var(--border);
  background: var(--card);
  color: var(--text-secondary);
}
.filter-tab.active {
  background: var(--primary);
  color: #000;
  border-color: var(--primary);
  font-weight: 800;
}
.overview-cards {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 10px;
  padding: 0 20px 16px;
}
.overview-card {
  background: var(--card);
  border-radius: 14px;
  padding: 16px;
  border: 1px solid var(--border);
  text-align: center;
}
.overview-val {
  font-size: 24px;
  font-weight: 700;
  color: var(--primary);
  display: block;
}
.overview-lbl {
  font-size: 12px;
  color: var(--text-secondary);
  margin-top: 4px;
  display: block;
}
.chart-section {
  padding: 0 20px;
  margin-bottom: 16px;
}
.chart-card {
  background: var(--card);
  border-radius: 14px;
  padding: 20px;
  border: 1px solid var(--border);
}
.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14px;
}
.chart-title {
  font-size: 15px;
  font-weight: 600;
  color: var(--text-primary);
}
.chart-period {
  font-size: 12px;
  color: var(--text-secondary);
}
.chart-canvas-wrap {
  width: 100%;
  height: 170px;
  background: var(--paper);
  border-radius: 8px;
  padding: 0;
  border: 1px dashed var(--border);
  overflow: hidden;
}
.weight-chart-canvas {
  width: 320px;
  height: 170px;
  display: block;
}
.chart-legend {
  display: flex;
  gap: 16px;
  margin-top: 12px;
  justify-content: center;
}
.chart-legend-item {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: var(--text-secondary);
}
.chart-legend-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
}
.chart-legend-dot.primary {
  background: var(--primary);
}
.chart-legend-dot.accent {
  background: var(--accent);
}
.milestone-section {
  padding: 0 20px;
  margin-bottom: 16px;
}
.milestone-card {
  background: var(--card);
  border-radius: 12px;
  padding: 14px 16px;
  border: 1px solid var(--border);
  text-align: center;
  min-width: 110px;
  opacity: 0.5;
}
.milestone-card.achieved {
  opacity: 1;
  border-color: var(--success);
  background: rgba(204, 255, 0, 0.08);
}
.milestone-icon {
  font-size: 24px;
  margin-bottom: 6px;
}
.milestone-name {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
}
.milestone-date {
  font-size: 11px;
  color: var(--text-secondary);
  display: block;
  margin-top: 4px;
}
.data-table {
  width: 100%;
  border-collapse: collapse;
}
.data-tr {
  display: flex;
  border-bottom: 1px solid var(--border);
}
.data-tr:last-child {
  border-bottom: none;
}
.data-th .data-td {
  font-weight: 600;
  color: var(--text-secondary);
  font-size: 12px;
}
.data-td {
  flex: 1;
  padding: 10px 8px;
  font-size: 13px;
  color: var(--text-primary);
}
.weekly-analysis {
  padding: 0 20px;
  margin-bottom: 24px;
}
.analysis-card {
  background: var(--card);
  border-radius: 12px;
  padding: 14px 16px;
  margin-bottom: 8px;
  border: 1px solid var(--border);
  display: flex;
  align-items: center;
  gap: 12px;
}
.analysis-icon {
  font-size: 24px;
  flex-shrink: 0;
}
.analysis-info {
  flex: 1;
}
.analysis-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
}
.analysis-desc {
  font-size: 12px;
  color: var(--text-secondary);
  display: block;
  margin-top: 2px;
}
.analysis-status {
  padding: 4px 10px;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 600;
  flex-shrink: 0;
}
.analysis-status.status-good {
  background: rgba(204, 255, 0, 0.12);
  color: var(--success);
}
.analysis-status.status-warn {
  background: rgba(255, 61, 0, 0.16);
  color: var(--danger);
}

/* === tab-bar bottom padding === */
.page-container { padding-bottom: calc(76px + env(safe-area-inset-bottom)) !important; }
