/* 动作说明页 - 补充样式 */

.exercise-name-section {
  padding: 0 20px;
  margin-bottom: 16px;
}

.exercise-main-name {
  font-size: 22px;
  font-weight: 700;
  color: var(--text-primary);
}

.exercise-eng-name {
  font-size: 14px;
  color: var(--text-secondary);
  margin-top: 4px;
}

.exercise-tags {
  display: flex;
  gap: 8px;
  margin-top: 10px;
  flex-wrap: wrap;
}

.exercise-tag {
  padding: 6px 12px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 3px;
  line-height: 1;
}

.tag-level {
  background: var(--primary);
  color: #000;
  font-weight: 800;
  padding: 6px 14px;
  box-shadow: 0 2px 10px rgba(204, 255, 0, 0.3);
}
.tag-muscle,
.tag-type {
  background: rgba(255, 255, 255, 0.04);
  color: rgba(255, 255, 255, 0.55);
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.muscle-group {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.muscle-tag {
  padding: 8px 16px;
  background: var(--primary-light);
  color: var(--primary);
  border: 1px solid rgba(204, 255, 0, 0.18);
  border-radius: 10px;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.2px;
}

.points-list {
  /* 容器样式 */
}

.points-list > view {
  display: flex;
  gap: 10px;
  margin-bottom: 12px;
  font-size: 14px;
  color: var(--text-primary);
  line-height: 1.6;
}

.points-list > view:last-child {
  margin-bottom: 0;
}

.point-num {
  width: 22px;
  height: 22px;
  min-width: 22px;
  border-radius: 50%;
  background: var(--primary);
  color: #000;
  font-size: 12px;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2px;
}

.caution-list .point-num {
  background: var(--danger);
  color: #FFF;
}

.exercise-hero {
  margin: 16px 20px;
  border-radius: 16px;
  height: 180px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFF;
  font-size: 72px;
  background: var(--paper) !important;
  border: 1px solid var(--border);
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4),
              0 0 60px rgba(204, 255, 0, 0.08);
  position: relative;
  overflow: hidden;
}

.breath-row {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 6px 0;
}

.breath-row + .breath-row {
  border-top: 1px solid rgba(255, 255, 255, 0.06);
  margin-top: 6px;
}

.breath-phase {
  font-size: 13px;
  font-weight: 600;
  color: var(--primary);
}

.breath-text {
  font-size: 13px;
  color: var(--text-primary);
  line-height: 1.5;
}

.caution-item {
  display: flex;
  gap: 10px;
  align-items: flex-start;
}

.caution-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.caution-title {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-primary);
}

.caution-text {
  font-size: 12px;
  color: var(--text-secondary);
  line-height: 1.5;
}
