<view class="page-container no-tab welcome-magazine">
  <!-- 超大混排标题 -->
  <view class="mag-header">
    <text class="mag-logo">飞特八弟</text>
    <text class="mag-tagline">你的 AI 私人健身教练</text>
    <text class="mag-date">每天 20 分钟，轻松练出好体态</text>
  </view>

  <!-- 橙色封面大卡 -->
  <view class="mag-cover">
    <view class="mag-cover-emoji">🏋️</view>
    <text class="mag-cover-title">今天，从一次训练开始</text>
    <text class="mag-cover-sub">基于你的身体数据，AI 生成专属每日训练计划</text>
    <button wx:if="{{hasProfile}}" class="mag-cover-btn" bindtap="goToAnalysis">查看我的分析报告</button>
    <button wx:else class="mag-cover-btn" bindtap="goToBasicInfo">开始建档</button>
  </view>

  <!-- 不对称双卖点卡 -->
  <view class="mag-duo">
    <view class="mag-duo-card">
      <text class="mag-duo-num">4 大</text>
      <text class="mag-duo-label">训练维度覆盖</text>
    </view>
    <view class="mag-duo-card">
      <text class="mag-duo-num">30+</text>
      <text class="mag-duo-label">标准动作指导</text>
    </view>
  </view>

  <!-- 功能介绍 -->
  <view class="features-section">
    <text class="features-section-title">飞特八弟 能为你做什么</text>
    <view class="mag-feature-grid">
      <view class="mag-feature-card">
        <view class="mag-feature-icon orange">📊</view>
        <text class="mag-feature-title">个性化训练计划</text>
        <text class="mag-feature-desc">基于身体数据与目标，AI 生成每日/每周/每月方案</text>
      </view>
      <view class="mag-feature-card">
        <view class="mag-feature-icon green">🔄</view>
        <text class="mag-feature-title">动态智能调整</text>
        <text class="mag-feature-desc">根据完成度与身体反馈，每周自动优化强度</text>
      </view>
      <view class="mag-feature-card">
        <view class="mag-feature-icon blue">📐</view>
        <text class="mag-feature-title">专业动作指导</text>
        <text class="mag-feature-desc">每个训练动作配有详细说明与常见错误纠正</text>
      </view>
      <view class="mag-feature-card">
        <view class="mag-feature-icon purple">📈</view>
        <text class="mag-feature-title">全方位进度追踪</text>
        <text class="mag-feature-desc">体重、围度、体脂变化一目了然，里程碑激励</text>
      </view>
    </view>
  </view>

  <!-- 已有档案：资料卡片 -->
  <view wx:if="{{hasProfile}}" class="profile-section">
    <view class="profile-card">
      <view class="profile-header-mod">
        <view class="profile-title">
          <view class="profile-title-icon" style="background:var(--primary-light);border-radius:6px;width:24px;height:24px;display:flex;align-items:center;justify-content:center;">
            <text style="color:var(--primary);font-size:14px;">👤</text>
          </view>
          <text>我的基本资料</text>
        </view>
        <view class="profile-action" bindtap="onEditProfile" style="font-size:13px;color:var(--primary);display:flex;align-items:center;gap:2px;">
          <text>✏️ 编辑</text>
        </view>
      </view>
      <view class="profile-grid">
        <view class="profile-item">
          <text class="profile-label">昵称</text>
          <text class="profile-value">{{profile.nickname}}</text>
        </view>
        <view class="profile-item">
          <text class="profile-label">性别</text>
          <view class="profile-value">
            <text class="profile-tag {{profile.gender === 'male' ? 'male' : 'female'}}">{{profile.gender === 'male' ? '男' : '女'}}</text>
          </view>
        </view>
        <view class="profile-item">
          <text class="profile-label">年龄</text>
          <text class="profile-value">{{profile.age}} 岁</text>
        </view>
        <view class="profile-item">
          <text class="profile-label">身高</text>
          <text class="profile-value">{{profile.height}} cm</text>
        </view>
        <view class="profile-item">
          <text class="profile-label">体重</text>
          <text class="profile-value">{{profile.weight}} kg</text>
        </view>
        <view class="profile-item">
          <text class="profile-label">BMI</text>
          <view class="profile-value">
            <text>{{bmi.value}}</text>
            <text class="profile-tag {{bmiTagClass}}" style="{{bmiTagStyle}}">{{bmi.categoryCN}}</text>
          </view>
        </view>
        <view class="profile-item full">
          <text class="profile-label">健身目标</text>
          <text class="profile-value">{{profile.goal}}</text>
        </view>
      </view>
    </view>
  </view>

  <text class="privacy-note">你的数据仅用于制定训练计划，不会被分享</text>
</view>
