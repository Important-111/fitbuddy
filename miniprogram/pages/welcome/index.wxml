<view class="page-container welcome-page">
  <!-- 顶部欢迎区 -->
  <view class="welcome-hero">
    <view class="hero-icon">
      <text class="hero-icon-emoji">🏋️</text>
    </view>
    <text class="hero-title">飞特八弟</text>
    <text class="hero-title2">你的AI私人健身教练</text>
    <text class="hero-subtitle">陪你达成每一个目标</text>
  </view>

  <!-- 已有档案：基本资料卡片（对齐原型 v32235 档案 6+1 字段 grid） -->
  <view wx:if="{{hasProfile}}" class="profile-section">
    <view class="profile-card">
      <view class="profile-header">
        <view class="profile-title">
          <view class="profile-title-icon">
            <text style="color:var(--primary);font-size:14px;">👤</text>
          </view>
          <text>我的基本资料</text>
        </view>
        <view class="profile-action" bindtap="openEditModal">
          <text>✏️ 编辑</text>
        </view>
      </view>
      <view class="profile-grid">
        <view class="profile-item">
          <text class="profile-label">昵称</text>
          <text class="profile-value">{{profile.nickname}}</text>
        </view>
        <view class="profile-item">
          <text class="profile-label">性别</text>
          <view class="profile-value">
            <text class="profile-tag {{profile.gender === 'male' ? 'male' : 'female'}}">{{profile.gender === 'male' ? '男' : '女'}}</text>
          </view>
        </view>
        <view class="profile-item">
          <text class="profile-label">年龄</text>
          <text class="profile-value">{{profile.age}} 岁</text>
        </view>
        <view class="profile-item">
          <text class="profile-label">身高</text>
          <text class="profile-value">{{profile.height}} cm</text>
        </view>
        <view class="profile-item">
          <text class="profile-label">体重</text>
          <text class="profile-value">{{profile.weight}} kg</text>
        </view>
        <view class="profile-item">
          <text class="profile-label">BMI</text>
          <view class="profile-value">
            <text>{{bmi.value}}</text>
            <text class="profile-tag" style="{{bmiTagStyle}}">{{bmi.categoryCN}}</text>
          </view>
        </view>
        <view class="profile-item full">
          <text class="profile-label">健身目标</text>
          <text class="profile-value">{{profile.goal}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 功能特点（横向卡片，对齐原型 feature-card） -->
  <view class="features-section">
    <text class="features-section-title">飞特八弟 能为你做什么</text>
    <view class="feature-card">
      <view class="feature-icon orange">📊</view>
      <view class="feature-text">
        <text class="feature-title">个性化训练计划</text>
        <text class="feature-desc">基于你的身体数据和目标，AI生成专属每日/每周/每月训练方案</text>
      </view>
    </view>
    <view class="feature-card">
      <view class="feature-icon green">🔄</view>
      <view class="feature-text">
        <text class="feature-title">动态智能调整</text>
        <text class="feature-desc">根据训练完成度和身体反馈，每周自动优化训练强度和内容</text>
      </view>
    </view>
    <view class="feature-card">
      <view class="feature-icon blue">📐</view>
      <view class="feature-text">
        <text class="feature-title">专业动作指导</text>
        <text class="feature-desc">每个训练动作配有详细说明与常见错误纠正</text>
      </view>
    </view>
    <view class="feature-card">
      <view class="feature-icon purple">📈</view>
      <view class="feature-text">
        <text class="feature-title">全方位进度追踪</text>
        <text class="feature-desc">体重、围度、体脂变化一目了然，里程碑激励让你保持动力</text>
      </view>
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="bottom-cta">
    <button wx:if="{{hasProfile}}" class="btn-primary" bindtap="goToAnalysis">查看我的分析报告</button>
    <button wx:else class="btn-primary" bindtap="goToBasicInfo">开始建档</button>
    <text class="privacy-note">你的数据仅用于制定训练计划，不会被分享</text>
  </view>
</view>

<!-- 编辑基本资料弹窗（对齐原型 v32235 modal） -->
<view wx:if="{{showEditModal}}" class="modal-overlay" bindtap="closeEditModal">
  <view class="modal" catchtap="noop">
    <view class="modal-header">
      <text class="modal-title">编辑基本资料</text>
      <view class="modal-close" catchtap="closeEditModal">
        <text class="modal-close-x">×</text>
      </view>
    </view>
    <view class="modal-body">
      <view class="form-row">
        <text class="form-label">昵称</text>
        <input class="form-input" type="nickname" value="{{editForm.nickname}}" maxlength="20" placeholder="请输入昵称" bindinput="onEditInput" data-field="nickname" />
      </view>
      <view class="form-row">
        <text class="form-label">性别</text>
        <picker class="form-picker" range="{{genderOptions}}" value="{{editForm.genderIndex}}" bindchange="onGenderChange">
          <view class="form-input picker-value">
            <text>{{genderOptions[editForm.genderIndex]}}</text>
          </view>
        </picker>
      </view>
      <view class="form-row">
        <text class="form-label">年龄</text>
        <input class="form-input" type="number" value="{{editForm.age}}" placeholder="10-100" bindinput="onEditInput" data-field="age" />
        <text class="form-hint">单位：岁</text>
      </view>
      <view class="form-row">
        <text class="form-label">身高</text>
        <input class="form-input" type="number" value="{{editForm.height}}" placeholder="100-250" bindinput="onEditInput" data-field="height" />
        <text class="form-hint">单位：cm</text>
      </view>
      <view class="form-row">
        <text class="form-label">体重</text>
        <input class="form-input" type="number" value="{{editForm.weight}}" placeholder="30-300" bindinput="onEditInput" data-field="weight" />
        <text class="form-hint">单位：kg</text>
      </view>
      <view class="form-row">
        <text class="form-label">健身目标</text>
        <picker class="form-picker" range="{{goalOptions}}" value="{{editForm.goalIndex}}" bindchange="onGoalChange">
          <view class="form-input picker-value">
            <text>{{goalOptions[editForm.goalIndex]}}</text>
          </view>
        </picker>
      </view>
    </view>
    <view class="modal-footer">
      <button class="btn-secondary" catchtap="closeEditModal">取消</button>
      <button class="btn-confirm" catchtap="saveProfile">保存</button>
    </view>
  </view>
</view>
