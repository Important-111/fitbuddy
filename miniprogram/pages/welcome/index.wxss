/* Welcome page - 暗黑力量（对齐 HTML 原型） */
.page-container.welcome-page {
  background:
    radial-gradient(ellipse 600rpx 400rpx at 80% 0%, rgba(204,255,0,0.10), transparent 60%),
    radial-gradient(ellipse 500rpx 400rpx at 0% 100%, rgba(255,61,0,0.10), transparent 60%),
    var(--bg);
  min-height: 100vh;
  padding-bottom: 40px;
  overflow-x: hidden;
}

/* 顶部欢迎区 */
.welcome-hero {
  background:
    radial-gradient(ellipse 400rpx 200rpx at 50% 0%, rgba(204,255,0,0.15), transparent 70%),
    linear-gradient(135deg, #0F0F0F 0%, #1A1A1A 100%);
  padding: 60px 24px 80px;
  text-align: center;
  position: relative;
  overflow: hidden;
  border-bottom: 1px solid rgba(255,255,255,0.08);
}
.hero-icon {
  width: 80px;
  height: 80px;
  background: rgba(204,255,0,0.15);
  border: 1px solid var(--primary);
  border-radius: 24px;
  margin: 0 auto 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 40px rgba(204,255,0,0.4);
}
.hero-icon-emoji {
  font-size: 40px;
  line-height: 1;
}
.hero-title {
  display: block;
  font-size: 32px;
  font-weight: 900;
  color: var(--primary);
  margin-bottom: 8px;
  letter-spacing: -0.5px;
  text-shadow: 0 0 20px rgba(204,255,0,0.3);
}
.hero-title2 {
  display: block;
  font-size: 20px;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8px;
  letter-spacing: 0.5px;
}
.hero-subtitle {
  display: block;
  font-size: 12px;
  color: var(--text-secondary);
  font-weight: 600;
  letter-spacing: 2px;
}

/* 基本资料模块 */
.profile-section {
  padding: 20px 24px 12px;
  margin: 0 0 8px;
  position: relative;
  z-index: 2;
}
.profile-card {
  background: var(--card);
  border-radius: 20px;
  padding: 22px 22px 26px;
  border: 1px solid var(--border);
}
.profile-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
  padding-bottom: 12px;
  border-bottom: 1px dashed var(--border);
}
.profile-title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 15px;
  font-weight: 700;
  color: var(--text-primary);
}
.profile-title-icon {
  width: 24px;
  height: 24px;
  background: var(--primary-light);
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.profile-action {
  font-size: 13px;
  color: var(--primary);
  display: flex;
  align-items: center;
  gap: 2px;
}
.profile-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px 20px;
}
.profile-item {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.profile-item.full {
  grid-column: span 2;
}
.profile-label {
  font-size: 12px;
  color: var(--text-tertiary);
}
.profile-value {
  font-size: 15px;
  color: var(--text-primary);
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 6px;
}
.profile-tag {
  display: inline-block;
  padding: 2px 8px;
  background: var(--primary-light);
  color: var(--primary);
  border: 1px solid rgba(204,255,0,0.3);
  border-radius: 4px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.5px;
}
.profile-tag.male,
.profile-tag.female {
  background: var(--primary-light);
  color: var(--primary);
  border-color: rgba(204, 255, 0, 0.3);
}

/* 功能特点（横向卡片） */
.features-section {
  padding: 16px 24px 24px;
}
.features-section-title {
  display: block;
  font-size: 15px;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12px;
}
.feature-card {
  background: #242424;
  border-radius: 16px;
  padding: 14px;
  margin-bottom: 10px;
  display: flex;
  align-items: center;
  gap: 14px;
  border: 1px solid var(--border);
}
.feature-icon {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 20px;
}
.feature-icon.orange { background: var(--primary-light); }
.feature-icon.green { background: rgba(255,61,0,0.18); }
.feature-icon.blue { background: rgba(54,207,201,0.12); }
.feature-icon.purple { background: rgba(139,92,246,0.18); }
.feature-text {
  flex: 1;
  min-width: 0;
}
.feature-title {
  display: block;
  font-size: 14px;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 2px;
}
.feature-desc {
  display: block;
  font-size: 12px;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* 底部操作 */
.bottom-cta {
  padding: 12px 24px 36px;
}
.bottom-cta .btn-primary {
  width: 100%;
  height: 58px;
  line-height: 58px;
  background: var(--primary);
  color: #000;
  border: none;
  border-radius: 14px;
  font-size: 17px;
  font-weight: 800;
  letter-spacing: 1px;
  text-align: center;
  padding: 0;
  box-shadow: 0 6px 24px rgba(204,255,0,0.45);
}
.privacy-note {
  display: block;
  text-align: center;
  font-size: 12px;
  color: var(--text-secondary);
  margin-top: 16px;
  line-height: 1.5;
}
