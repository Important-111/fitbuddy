/* Welcome page - 暗黑力量 */
.page-container.welcome-magazine {
  background: var(--bg);
  min-height: 100vh;
}

/* 超大混排标题 */
.mag-header {
  padding: 56px 24px 8px;
}
.mag-logo {
  display: block;
  font-size: 34px;
  font-weight: 700;
  color: var(--primary);
  letter-spacing: 1px;
  line-height: 1.2;
}
.mag-tagline {
  display: block;
  margin-top: 6px;
  font-size: 16px;
  font-weight: 600;
  color: var(--text-primary);
}
.mag-date {
  display: block;
  margin-top: 4px;
  font-size: 13px;
  color: var(--text-secondary);
}

/* 橙色封面大卡 */
.mag-cover {
  margin: 18px 24px 0;
  background: var(--primary);
  border-radius: 20px;
  padding: 24px 22px 22px;
}
.mag-cover-emoji {
  width: 56px;
  height: 56px;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30px;
  margin-bottom: 14px;
}
.mag-cover-title {
  display: block;
  font-size: 22px;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.35;
}
.mag-cover-sub {
  display: block;
  margin-top: 8px;
  font-size: 13px;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.5;
}
.mag-cover-btn {
  margin-top: 18px;
  background: #0A0A0A;
  color: var(--primary);
  font-size: 15px;
  font-weight: 600;
  border-radius: 24px;
  padding: 10px 0;
  line-height: 1.4;
}

/* 不对称双卖点卡 */
.mag-duo {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin: 16px 24px 0;
}
.mag-duo-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 16px 18px;
}
.mag-duo-num {
  display: block;
  font-size: 24px;
  font-weight: 700;
  color: var(--primary);
}
.mag-duo-label {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  color: var(--text-secondary);
}

/* 功能介绍网格 */
.features-section {
  padding: 24px 24px 0;
}
.features-section-title {
  display: block;
  font-size: 16px;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 14px;
}
.mag-feature-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}
.mag-feature-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 16px 14px;
}
.mag-feature-icon {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  margin-bottom: 10px;
}
.mag-feature-icon.orange { background: rgba(255, 61, 0, 0.18); }
.mag-feature-icon.green { background: rgba(204, 255, 0, 0.15); }
.mag-feature-icon.blue { background: rgba(80, 180, 255, 0.18); }
.mag-feature-icon.purple { background: rgba(180, 100, 255, 0.18); }
.mag-feature-title {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4px;
}
.mag-feature-desc {
  display: block;
  font-size: 11px;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* 档案卡片（沿用原结构） */
.profile-header-mod {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
  padding-bottom: 12px;
  border-bottom: 1px dashed var(--border);
}
.profile-title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 15px;
  font-weight: 700;
  color: var(--text-primary);
}
.profile-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px 20px;
}
.profile-item.full {
  grid-column: span 2;
}
.profile-tag.male {
  background: rgba(22, 93, 255, 0.1);
  color: #165DFF;
}
.profile-tag.female {
  background: rgba(236, 72, 153, 0.1);
  color: #EC4899;
}

/* 隐私说明 */
.privacy-note {
  display: block;
  text-align: center;
  font-size: 12px;
  color: var(--text-secondary);
  padding: 20px 24px 32px;
}
