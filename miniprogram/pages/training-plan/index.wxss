/* 训练计划页 - 补充样式 */

/* ===== 顶栏「编辑条件」入口 =====
   与欢迎页 .profile-action 同一视觉语言：主色文字按钮，不抢主 CTA 的注意力 */
.top-edit {
  font-size: 13px;
  font-weight: 600;
  color: var(--primary);
  display: flex;
  align-items: center;
  gap: 2px;
  padding: 4px 0;
}

/* ===== 月目标卡片增强 ===== */
.month-goal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* 头部右侧簇：「改目标」+ 完成率徽章。
   包一层是为了让 space-between 仍然是「标题在左、徽章在右」 */
.month-goal-header-right {
  display: flex;
  align-items: center;
  gap: 10px;
}

/* 「改目标」入口：与顶栏 .top-edit 同一文字按钮语言，不抢主 CTA 的注意力。
   纵向 6px 内边距让高度贴近右侧徽章，同时把点击热区撑到可用的尺寸 */
.month-goal-edit {
  font-size: 13px;
  font-weight: 600;
  color: var(--primary);
  padding: 6px 2px;
}

.month-goal-badge {
  font-size: 12px;
  font-weight: 700;
  background: rgba(204,255,0,0.12);
  color: var(--primary);
  padding: 4px 14px;
  border-radius: 20px;
  border: 1px solid rgba(204,255,0,0.3);
}

.month-goal-divider {
  height: 1px;
  background: rgba(255,255,255,0.08);
  margin: 14px 0 10px;
}

.month-goal-item {
  text-align: center;
  flex: 1;
}

.month-goal-item-val {
  font-size: 22px;
  font-weight: 700;
  color: var(--primary);
}

.month-goal-item-lbl {
  font-size: 11px;
  color: var(--text-secondary);
  margin-top: 3px;
}

.month-goals {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.status-rest {
  background: var(--paper);
  color: var(--text-secondary);
}

.day-meta {
  display: flex;
  gap: 6px;
  margin-top: 4px;
  flex-wrap: wrap;
}

.day-meta-item {
  font-size: 11px;
  color: var(--primary);
  background: rgba(204, 255, 0,0.08);
  padding: 2px 10px;
  border-radius: 4px;
}

.summary-section {
  padding: 0 20px;
  margin-bottom: 20px;
}

.summary-title {
  font-size: 15px;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12px;
  padding-left: 10px;
  border-left: 3px solid var(--primary);
}

.summary-card {
  background: var(--card);
  border-radius: 14px;
  padding: 16px;
  border: 1px solid var(--border);
  display: flex;
  justify-content: space-around;
}

.summary-item {
  text-align: center;
}

.summary-item-val {
  font-size: 18px;
  font-weight: 700;
  color: var(--primary);
}

.summary-item-lbl {
  font-size: 11px;
  color: var(--text-secondary);
  margin-top: 2px;
}

/* === tab-bar bottom padding === */
.page-container { padding-bottom: calc(76px + env(safe-area-inset-bottom)) !important; }

/* 健康调整说明条：安全类提示，用警告色，不用主色 */
.safety-banner {
  margin: 0 20px 12px;
  padding: 12px 14px;
  border-radius: 12px;
  background: rgba(255, 61, 0, 0.10);
  border: 1px solid rgba(255, 61, 0, 0.35);
}
.safety-banner-title {
  font-size: 13px;
  font-weight: 700;
  color: var(--danger);
  display: block;
  margin-bottom: 4px;
}
.safety-banner-text {
  font-size: 12px;
  line-height: 1.6;
  color: var(--text-secondary);
  display: block;
}
