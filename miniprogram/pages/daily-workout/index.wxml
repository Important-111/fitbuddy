<view class="page-container">
  <!-- 顶部栏 -->
  <view class="top-bar">
    <view class="nav-back" bindtap="navigateBack">
      <text style="font-size:22px;font-weight:300;line-height:1;color:var(--text-primary);margin-top:-2px;">‹</text>
    </view>
    <text class="top-bar-title" style="flex:1;text-align:center;margin-right:36px;">今日训练</text>
  </view>

  <!-- 训练头部渐变区 -->
  <view class="workout-header" style="background:linear-gradient(135deg,#CCFF00,#B8E600);">
    <view class="workout-header-top">
      <view>
        <text style="font-size:20px;font-weight:700;">{{workoutName}}</text>
        <text style="font-size:13px;opacity:0.9;display:block;margin-top:4px;">{{workoutSub}}</text>
      </view>
    </view>
    <view class="workout-meta">
      <view class="workout-meta-item">
        <view class="workout-meta-val">{{workoutMinutes}}</view>
        <view class="workout-meta-lbl">分钟</view>
      </view>
      <view class="workout-meta-item">
        <view class="workout-meta-val">{{exercises.length}}+{{stretches.length}}</view>
        <view class="workout-meta-lbl">动作+拉伸</view>
      </view>
      <view class="workout-meta-item">
        <view class="workout-meta-val">{{workoutCalories}}</view>
        <view class="workout-meta-lbl">预计消耗(kcal)</view>
      </view>
    </view>
  </view>

  <!-- 热身激活阶段 -->
  <view class="phase-section">
    <view class="phase-title">
      <text class="phase-icon warmup">🔥</text>
      <text>热身激活</text>
      <view class="phase-edit" catchtap="openWarmupSelect">选择动作 ›</view>
    </view>
    <view
      wx:for="{{warmups}}"
      wx:key="name"
      class="exercise-card {{item.done ? 'completed' : ''}}"
    >
      <view class="exercise-num">
        <text>{{item.num}}</text>
      </view>
      <view class="exercise-info">
        <view class="exercise-name"><text class="ex-emoji">{{item.emoji}}</text>{{item.name}}</view>
        <view class="exercise-detail">{{item.detail}}</view>
        <view class="exercise-sets" wx:if="{{item.sets}}">{{item.sets}}</view>
      </view>

      <!-- 倒计时器 -->
      <view
        class="exercise-timer {{item.timerState}}"
        catchtap="noop"
        data-idx="{{index}}"
        data-list="warmups"
      >
        <text class="timer-display">{{item.timerDisplay}}</text>
        <view class="timer-controls">
          <view class="timer-btn adjust" catchtap="adjustTimer" data-list="warmups" data-idx="{{index}}" data-delta="-15">−15s</view>
          <view class="timer-btn start" catchtap="toggleTimer" data-list="warmups" data-idx="{{index}}">{{item.timerBtnLabel}}</view>
          <view class="timer-btn adjust" catchtap="adjustTimer" data-list="warmups" data-idx="{{index}}" data-delta="15">+15s</view>
        </view>
        <view class="timer-counter">
          <block wx:if="{{item.totalSets > 0}}"><text class="counter-done">{{item.completedSets}}</text>/{{item.totalSets}} 组</block>
          <block wx:else>已完成 {{item.completedSets}} 次</block>
        </view>
      </view>
    </view>
  </view>

  <!-- 正式训练阶段 -->
  <view class="phase-section">
    <view class="phase-title">
      <text class="phase-icon main">💪</text>
      <text>正式训练（35分钟）</text>
    </view>
    <view wx:for="{{exercises}}" wx:key="num">
      <view
        class="exercise-card"
        bindtap="navigateTo"
        data-url="/pages/exercise-detail/index?id={{item.exId}}"
      >
        <view class="exercise-num">{{item.num}}</view>
        <view class="exercise-info">
          <view class="exercise-name">{{item.name}}</view>
          <view class="exercise-detail">{{item.detail}}</view>
          <view class="exercise-sets">{{item.sets}}</view>
          <view class="exercise-rest" wx:if="{{item.rest}}">{{item.rest}}</view>
        </view>

        <!-- 倒计时器 -->
        <view
          class="exercise-timer {{item.timerState}}"
          catchtap="noop"
          data-idx="{{index}}"
          data-list="exercises"
        >
          <text class="timer-display">{{item.timerDisplay}}</text>
          <view class="timer-controls">
            <view class="timer-btn adjust" catchtap="adjustTimer" data-list="exercises" data-idx="{{index}}" data-delta="-15">−15s</view>
            <view class="timer-btn start" catchtap="toggleTimer" data-list="exercises" data-idx="{{index}}">{{item.timerBtnLabel}}</view>
            <view class="timer-btn adjust" catchtap="adjustTimer" data-list="exercises" data-idx="{{index}}" data-delta="15">+15s</view>
          </view>
          <view class="timer-counter">
            <block wx:if="{{item.totalSets > 0}}"><text class="counter-done">{{item.completedSets}}</text>/{{item.totalSets}} 组</block>
            <block wx:else>已完成 {{item.completedSets}} 次</block>
          </view>
        </view>

          <view class="swap-btn" catchtap="openSwap" data-exid="{{item.exId}}" wx:if="{{item.swaps.length}}">换</view>

          <view class="exercise-arrow">›</view>
        </view>
        <view wx:if="{{index < exercises.length - 1}}" class="flow-arrow">↓</view>
    </view>
  </view>

  <!-- 训练后拉伸阶段 -->
  <view class="phase-section">
    <view class="phase-title">
      <text class="phase-icon stretch">🧘</text>
      <text>训练后拉伸（8分钟）</text>
    </view>
    <view wx:for="{{stretches}}" wx:for-index="idx" wx:key="name" class="stretch-card">
      <view class="exercise-num">{{idx + 1}}</view>
      <view class="exercise-info">
        <view class="exercise-name">{{item.name}}</view>
        <view class="exercise-detail">{{item.detail}}</view>
      </view>

      <!-- 倒计时器 -->
      <view
        class="exercise-timer {{item.timerState}}"
        catchtap="noop"
        data-idx="{{idx}}"
        data-list="stretches"
      >
        <text class="timer-display">{{item.timerDisplay}}</text>
        <view class="timer-controls">
          <view class="timer-btn adjust" catchtap="adjustTimer" data-list="stretches" data-idx="{{idx}}" data-delta="-15">−15s</view>
          <view class="timer-btn start" catchtap="toggleTimer" data-list="stretches" data-idx="{{idx}}">{{item.timerBtnLabel}}</view>
          <view class="timer-btn adjust" catchtap="adjustTimer" data-list="stretches" data-idx="{{idx}}" data-delta="15">+15s</view>
        </view>
        <view class="timer-counter">
          <block wx:if="{{item.totalSets > 0}}"><text class="counter-done">{{item.completedSets}}</text>/{{item.totalSets}} 组</block>
          <block wx:else>已完成 {{item.completedSets}} 次</block>
        </view>
      </view>
    </view>
  </view>

  <!-- 总消耗统计 -->
  <view class="total-calories">
    <view class="total-item">
      <view class="total-item-val">{{workoutCalories}}</view>
      <view class="total-item-lbl">预计消耗(kcal)</view>
    </view>
    <view class="total-item">
      <view class="total-item-val">{{workoutMinutes}}</view>
      <view class="total-item-lbl">训练时长(分钟)</view>
    </view>
    <view class="total-item">
      <view class="total-item-val">{{totalSets}}</view>
      <view class="total-item-lbl">总组数</view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <button class="btn-outline" catchtap="openSwapFromBottom">自由替换动作</button>
    <button class="btn-primary" bindtap="navigateTo" data-url="/pages/daily-checkin/index">完成训练 · 去打卡</button>
  </view>

  <!-- 底部「自由替换动作」：先选要替换哪个动作 -->
  <view class="swap-modal {{swapPickShow ? 'show' : ''}}" wx:if="{{swapPickShow}}">
    <view class="swap-content">
      <view class="swap-header">
        <view class="swap-title">选择要替换的动作</view>
        <view class="swap-close" catchtap="closeSwapPick">×</view>
      </view>
      <view class="swap-pick-tip">选择下方某个动作，进入它的可替换列表</view>
      <view class="swap-pick-list">
        <view
          wx:for="{{swapPickList}}"
          wx:key="exId"
          class="swap-pick-item"
          catchtap="openSwapPick"
          data-exid="{{item.exId}}"
        >
          <text class="swap-pick-emoji">{{item.emoji}}</text>
          <view class="swap-pick-info">
            <view class="swap-pick-name">{{item.name}}</view>
            <view class="swap-pick-sets">{{item.sets}}</view>
          </view>
          <view class="swap-pick-arrow">›</view>
        </view>
      </view>
    </view>
  </view>

  <!-- v2.1 自由替换动作弹窗 -->
  <view class="swap-modal {{swapShow ? 'show' : ''}}" wx:if="{{swapShow}}">
    <view class="swap-content">
      <view class="swap-header">
        <view class="swap-title">替换动作 · {{swapCurrent.name}}</view>
        <view class="swap-close" catchtap="closeSwap">×</view>
      </view>
      <view class="swap-current">
        <text class="swap-current-emoji">{{swapCurrent.emoji}}</text>
        <view>
          <view class="swap-current-label">当前动作</view>
          <view class="swap-current-name">{{swapCurrent.name}}</view>
        </view>
      </view>
      <view class="swap-options-title">选择替换动作（同肌群）</view>
      <view
        wx:for="{{swapOptions}}"
        wx:key="exId"
        class="swap-option"
        catchtap="applySwap"
        data-exid="{{item.exId}}"
      >
        <view class="swap-option-emoji">{{item.emoji}}</view>
        <view class="swap-option-info">
          <view class="swap-option-name">{{item.name}}</view>
          <view class="swap-option-detail">{{item.detail}}</view>
          <view class="swap-option-tags">
            <text wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this" wx:if="{{t}}" class="swap-option-tag">{{t}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 动态热身：选择热身动作弹窗 -->
  <view class="swap-modal {{warmupSelectShow ? 'show' : ''}}" wx:if="{{warmupSelectShow}}">
    <view class="swap-content warmup-content">
      <view class="swap-header">
        <view class="swap-title">选择热身动作</view>
        <view class="swap-close" catchtap="closeWarmupSelect">×</view>
      </view>
      <view class="warmup-tip">勾选本次训练前要做的热身项目，点「确定」应用到今日训练</view>
      <scroll-view scroll-y class="warmup-list">
        <view
          wx:for="{{warmupCandidates}}"
          wx:key="id"
          class="warmup-opt {{item.selected ? 'on' : ''}}"
          catchtap="toggleWarmup"
          data-id="{{item.id}}"
        >
          <view class="warmup-opt-emoji">{{item.emoji}}</view>
          <view class="warmup-opt-info">
            <view class="warmup-opt-name">{{item.name}}</view>
            <view class="warmup-opt-detail">{{item.detail}}</view>
          </view>
          <view class="warmup-check {{item.selected ? 'checked' : ''}}">{{item.selected ? '✓' : ''}}</view>
        </view>
      </scroll-view>
      <button class="btn-primary swap-confirm" catchtap="confirmWarmup">确定（{{warmupSelectedCount}}）</button>
    </view>
  </view>

  <!-- 最后5秒全屏倒数 -->
  <view class="countdown-overlay {{countdownPulse ? 'show pulse' : (countdownShow ? 'show' : '')}}" wx:if="{{countdownShow}}">
    <view class="countdown-number">{{countdownNum}}</view>
  </view>

  <!-- 组进度弹窗 -->
  <view class="set-progress-modal {{setProgressShow ? 'show' : ''}}" wx:if="{{setProgressShow}}">
    <view class="set-progress-content">
      <view class="set-progress-emoji">{{setProgress.isLast ? '🎉' : '🔥'}}</view>
      <view class="set-progress-title">{{setProgress.isLast ? '本动作全部完成！' : '本组完成！'}}</view>
      <view class="set-progress-sub">{{setProgress.exerciseName}}{{setProgress.isLast ? ' · 太棒了' : ' · 准备下一组'}}</view>
      <view class="set-progress-bar-wrap">
        <view class="set-progress-bar" style="width:{{setProgress.percent}}%"></view>
      </view>
      <view class="set-progress-labels">
        <text>已完成 <strong>{{setProgress.done}}</strong> 组</text>
        <text>共 <strong>{{setProgress.total > 0 ? setProgress.total : '—'}}</strong> 组</text>
      </view>
      <view class="set-progress-actions">
        <view class="btn-secondary" bindtap="closeSetProgress">查看动作</view>
        <view class="btn-primary-cta" bindtap="nextSet">{{setProgress.isLast ? '完成 ✓' : '下一组 ›'}}</view>
      </view>
    </view>
  </view>
</view>
