/* 每日训练详情页 - 补充样式 */

.exercise-sets {
  font-size: 13px;
  color: var(--primary);
  font-weight: 600;
  margin-top: 4px;
}

.exercise-rest {
  font-size: 12px;
  color: var(--text-secondary);
  margin-top: 2px;
}

.exercise-arrow {
  display: flex;
  align-items: center;
  color: var(--text-tertiary);
  font-size: 18px;
  padding-left: 8px;
}

.phase-icon {
  font-size: 18px;
}

.phase-icon.warmup {
  color: var(--primary);
}

.phase-icon.main {
  color: var(--success);
}

.phase-icon.stretch {
  color: var(--accent);
}

.total-calories {
  display: flex;
  justify-content: space-around;
  padding: 16px 20px;
  background: var(--card);
  margin: 0 20px 16px;
  border-radius: 14px;
  border: 1px solid var(--border);
}

.total-item {
  text-align: center;
}

.total-item-val {
  font-size: 18px;
  font-weight: 700;
  color: var(--text-primary);
}

.total-item-lbl {
  font-size: 11px;
  color: var(--text-secondary);
  margin-top: 2px;
}

.nav-back {
  width: 36px; height: 36px;
  display: flex; align-items: center; justify-content: center;
  border-radius: 8px;
  flex-shrink: 0;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 12px 20px;
  padding-bottom: calc(12px + env(safe-area-inset-bottom));
  background: var(--card);
  border-top: 1px solid var(--border);
  display: flex;
  gap: 12px;
  align-items: stretch;
}
.bottom-bar .btn-outline,
.bottom-bar .btn-primary {
  flex: 1;
  min-width: 0;
  width: auto;
  max-width: none;
  padding: 0;
  margin: 0;
  line-height: 1;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  text-align: center;
}

.stretch-card {
  background: var(--card);
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 10px;
  border: 1px solid var(--border);
  display: flex;
  gap: 14px;
  align-items: center;
}

.flow-arrow {
  text-align: center;
  font-size: 20px;
  color: var(--text-tertiary);
  padding: 4px 0;
}

/* === Countdown Timer === */
.exercise-timer {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 6px 8px;
  border-radius: 10px;
  background: rgba(0,0,0,0.04);
  border: 1px solid var(--border);
  min-width: 78px;
}
.exercise-card.completed .exercise-timer {
  opacity: 0.55;
}
.exercise-timer.running {
  background: rgba(255,107,53,0.08);
  border-color: var(--primary);
}
.exercise-timer.finished {
  background: rgba(16,185,129,0.12);
  border-color: var(--success);
}
.exercise-timer.finished .timer-display {
  color: var(--success);
}
.timer-display {
  font-size: 16px;
  font-weight: 700;
  color: var(--primary);
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.3px;
  line-height: 1.1;
}
.timer-controls {
  display: flex;
  gap: 4px;
  align-items: center;
}
.timer-btn {
  height: 22px;
  min-width: 22px;
  padding: 0 6px;
  border-radius: 6px;
  background: var(--card);
  color: var(--text-secondary);
  font-size: 11px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.timer-btn.adjust {
  font-size: 10px;
}
.stretch-card .exercise-timer {
  min-width: 70px;
}

/* === 计数显示 === */
.timer-counter {
  font-size: 10px;
  color: var(--text-tertiary);
  text-align: center;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
  margin-top: 2px;
}
.timer-counter .counter-done {
  color: var(--primary);
  font-weight: 700;
  font-size: 12px;
}
.exercise-timer.finished .timer-counter .counter-done {
  color: var(--success);
}

/* === 最后5秒全屏倒数 === */
.countdown-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.55);
  z-index: 1500;
  display: flex;
  align-items: center;
  justify-content: center;
}
.countdown-number {
  font-size: 200px;
  font-weight: 900;
  color: var(--primary);
  line-height: 1;
  text-shadow: 0 0 40px rgba(255,107,53,0.55);
  font-variant-numeric: tabular-nums;
}

/* === 组进度弹窗 === */
.set-progress-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.55);
  z-index: 1400;
  display: flex;
  align-items: center;
  justify-content: center;
}
.set-progress-content {
  background: var(--card);
  border-radius: 20px;
  padding: 28px 24px 20px;
  text-align: center;
  width: calc(100% - 80px);
  max-width: 340px;
  box-shadow: 0 20px 50px rgba(0,0,0,0.25);
}
.set-progress-emoji {
  font-size: 56px;
  margin-bottom: 8px;
  line-height: 1;
}
.set-progress-title {
  font-size: 19px;
  font-weight: 700;
  color: var(--text-primary);
}
.set-progress-sub {
  font-size: 13px;
  color: var(--text-secondary);
  margin-top: 4px;
}
.set-progress-bar-wrap {
  background: rgba(0,0,0,0.04);
  height: 10px;
  border-radius: 5px;
  overflow: hidden;
  margin: 16px 0 8px;
}
.set-progress-bar {
  height: 100%;
  background: var(--primary);
  border-radius: 5px;
  transition: width 0.4s ease;
}
.set-progress-labels {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  color: var(--text-secondary);
}
.set-progress-labels strong {
  color: var(--primary);
  font-weight: 700;
}
.set-progress-actions {
  display: flex;
  gap: 10px;
  margin-top: 18px;
}
.set-progress-actions .btn-secondary,
.set-progress-actions .btn-primary-cta {
  flex: 1;
  height: 44px;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.set-progress-actions .btn-secondary {
  background: rgba(0,0,0,0.04);
  color: var(--text-primary);
}
.set-progress-actions .btn-primary-cta {
  background: var(--primary);
  color: #FFF;
}

/* === v1.10 快速打卡按钮完成态 === */
.bottom-bar .btn-outline.done {
  background: var(--primary);
  color: #FFF;
  border-color: var(--primary);
}

/* === v2.1 换动作按钮 === */
.swap-btn {
  flex-shrink: 0;
  width: 30px;
  height: 30px;
  border: 1px dashed var(--primary);
  background: var(--card);
  border-radius: 8px;
  color: var(--primary);
  font-size: 14px;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 6px;
}
.swap-btn:active {
  transform: scale(0.92);
}
.exercise-card.swapping {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(54,207,201,0.18);
  transition: all 0.5s ease;
}

/* === v2.1 自由替换动作弹窗 === */
.swap-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.6);
  z-index: 1600;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.swap-content {
  background: var(--card);
  border-radius: 20px 20px 0 0;
  width: 100%;
  max-width: 430px;
  max-height: 80vh;
  overflow-y: auto;
  padding: 16px 20px calc(20px + env(safe-area-inset-bottom));
  animation: swapSlideUp 0.3s ease;
}
@keyframes swapSlideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.swap-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14px;
}
.swap-title {
  font-size: 17px;
  font-weight: 700;
  color: var(--text-primary);
}
.swap-close {
  width: 32px;
  height: 32px;
  border: none;
  background: rgba(0,0,0,0.04);
  border-radius: 50%;
  font-size: 20px;
  line-height: 32px;
  text-align: center;
  color: var(--text-secondary);
}
.swap-pick-tip {
  font-size: 13px;
  color: var(--text-secondary);
  margin-bottom: 12px;
}
.swap-pick-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.swap-pick-item {
  display: flex;
  align-items: center;
  padding: 12px 14px;
  background: var(--bg, #F5F6F8);
  border-radius: 14px;
}
.swap-pick-emoji {
  font-size: 24px;
  margin-right: 12px;
}
.swap-pick-info {
  flex: 1;
}
.swap-pick-name {
  font-size: 15px;
  font-weight: 600;
  color: var(--text-primary);
}
.swap-pick-sets {
  font-size: 12px;
  color: var(--text-secondary);
  margin-top: 2px;
}
.swap-pick-arrow {
  font-size: 20px;
  color: var(--text-secondary);
}
.swap-current {
  background: var(--primary-light);
  border-radius: 12px;
  padding: 12px 14px;
  margin-bottom: 14px;
  display: flex;
  align-items: center;
  gap: 10px;
}
.swap-current-label {
  font-size: 11px;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.swap-current-name {
  font-size: 15px;
  font-weight: 700;
  color: var(--primary);
  margin-left: 4px;
}
.swap-current-emoji {
  font-size: 22px;
}
.swap-options-title {
  font-size: 13px;
  color: var(--text-secondary);
  margin-bottom: 8px;
}
.swap-option {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 14px;
  margin-bottom: 10px;
  display: flex;
  gap: 12px;
  align-items: flex-start;
}
.swap-option:active {
  border-color: var(--primary);
  background: var(--primary-light);
}
.swap-option-emoji {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: var(--accent-light);
  color: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  flex-shrink: 0;
}
.swap-option-info {
  flex: 1;
  min-width: 0;
}
.swap-option-name {
  font-size: 15px;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 2px;
}
.swap-option-detail {
  font-size: 12px;
  color: var(--text-secondary);
  line-height: 1.4;
  margin-bottom: 4px;
}
.swap-option-tags {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}
.swap-option-tag {
  font-size: 11px;
  padding: 2px 8px;
  border-radius: 10px;
  background: rgba(0,0,0,0.04);
  color: var(--text-secondary);
}

/* 阶段标题「选择动作」入口 */
.phase-edit {
  margin-left: auto;
  font-size: 12px;
  color: var(--primary);
  background: var(--primary-light);
  padding: 4px 10px;
  border-radius: 999px;
  font-weight: 600;
}
.ex-emoji {
  margin-right: 6px;
  font-size: 15px;
}

/* 动态热身：选择热身动作弹窗 */
.warmup-content {
  max-height: 82vh;
}
.warmup-tip {
  font-size: 12px;
  color: var(--text-secondary);
  margin-bottom: 12px;
  line-height: 1.5;
}
.warmup-list {
  max-height: 52vh;
}
.warmup-opt {
  display: flex;
  align-items: center;
  gap: 12px;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 12px 14px;
  margin-bottom: 10px;
}
.warmup-opt.on {
  border-color: var(--primary);
  background: var(--primary-light);
}
.warmup-opt-emoji {
  font-size: 22px;
  flex-shrink: 0;
}
.warmup-opt-info {
  flex: 1;
  min-width: 0;
}
.warmup-opt-name {
  font-size: 14px;
  font-weight: 600;
  color: var(--text-primary);
}
.warmup-opt-detail {
  font-size: 12px;
  color: var(--text-secondary);
  margin-top: 2px;
  line-height: 1.4;
}
.warmup-check {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  border: 1.5px solid var(--border);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 13px;
}
.warmup-check.checked {
  background: var(--primary);
  border-color: var(--primary);
}
.swap-confirm {
  width: 100%;
  margin-top: 8px;
  background: var(--primary);
  color: #fff;
  border-radius: 999px;
  font-size: 15px;
  font-weight: 600;
  padding: 12px 0;
}
