.profile-header-card {
  margin: 16px 20px;
  border-radius: 20px;
  padding: 24px;
  color: #FFF;
  display: flex;
  align-items: center;
  gap: 16px;
  position: relative;
  overflow: hidden;
  border: 1px solid var(--border);
  background:
    radial-gradient(ellipse 320rpx 160rpx at 100% 0%, rgba(204,255,0,0.18), transparent 70%),
    radial-gradient(ellipse 240rpx 140rpx at 0% 100%, rgba(255,61,0,0.16), transparent 70%),
    linear-gradient(135deg, #242424 0%, #1A1A1A 100%);
}
.profile-avatar {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32px;
  flex-shrink: 0;
}
.profile-name {
  font-size: 20px;
  font-weight: 700;
}
.profile-goal {
  font-size: 13px;
  opacity: 0.85;
  margin-top: 2px;
  display: block;
}
.profile-tags {
  display: flex;
  gap: 6px;
  margin-top: 8px;
  flex-wrap: wrap;
}
.profile-tag {
  padding: 3px 10px;
  border-radius: 20px;
  font-size: 11px;
  background: rgba(255,255,255,0.2);
}
.menu-section {
  padding: 0 20px;
  margin-bottom: 16px;
}
.menu-card {
  background: var(--card);
  border-radius: 14px;
  border: 1px solid var(--border);
  overflow: hidden;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 14px 16px;
  border-bottom: 1px solid var(--border);
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-icon {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  margin-right: 12px;
  flex-shrink: 0;
}
.menu-text {
  flex: 1;
}
.menu-title {
  font-size: 14px;
  color: var(--text-primary);
  display: block;
}
.menu-desc {
  font-size: 11px;
  color: var(--text-secondary);
  display: block;
}
.menu-arrow {
  font-size: 20px;
  color: var(--text-tertiary);
}
.version-text {
  text-align: center;
  font-size: 11px;
  color: var(--text-secondary);
  margin-bottom: 16px;
  padding-bottom: 16px;
}
/* 退出登录按钮：主色玻璃态（不影响 .btn-secondary 其它复用场景） */
.logout-btn {
  width: 100%;
  height: 50px;
  border: 1px solid rgba(204,255,0,0.55);
  border-radius: 12px;
  background: rgba(255,255,255,0.06);
  color: var(--primary);
  font-size: 16px;
  font-weight: 700;
  letter-spacing: 0.5px;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  box-shadow: 0 0 18px rgba(204,255,0,0.20), inset 0 0 12px rgba(204,255,0,0.05);
  transition: all 0.2s;
}
.logout-btn:active {
  background: rgba(204,255,0,0.10);
  border-color: var(--primary);
  color: var(--primary);
  box-shadow: 0 0 28px rgba(204,255,0,0.40), inset 0 0 16px rgba(204,255,0,0.10);
  transform: scale(0.98);
}
.info-section .info-item:last-child {
  border-bottom: none !important;
}
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 24px;
  pointer-events: none;
}
.modal-overlay.show {
  display: flex;
  pointer-events: auto;
}
.modal {
  background: #1A1A1A;
  border-radius: 16px;
  width: 100%;
  max-width: 380px;
}
.modal-header {
  padding: 20px 20px 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--border);
}
.modal-title {
  font-size: 16px;
  font-weight: 700;
  color: var(--text-primary);
}
.modal-close {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  font-size: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
}
.modal-body {
  padding: 20px;
  max-height: 60vh;
  overflow-y: auto;
}
.modal-footer {
  padding: 12px 20px 20px;
  display: flex;
  gap: 12px;
}
.btn-settings {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
}
.goal-card-mini {
  transition: all 0.2s;
}
.goal-card-mini:active {
  opacity: 0.8;
}

/* === tab-bar bottom padding === */
.page-container { padding-bottom: calc(76px + env(safe-area-inset-bottom)) !important; }
