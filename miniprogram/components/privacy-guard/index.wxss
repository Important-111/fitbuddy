/* ===== 微信隐私保护指引授权弹窗（暗黑力量风格） ===== */

.privacy-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3000;
  padding: 48rpx;
  box-sizing: border-box;
}

.privacy-card {
  background: #1A1A1A;
  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 24rpx;
  padding: 48rpx 32rpx 32rpx;
  width: 100%;
  max-width: 600rpx;
  position: relative;
  text-align: center;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.60);
}

.privacy-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.privacy-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 20rpx;
}

.privacy-desc {
  font-size: 26rpx;
  color: #B0B0B0;
  line-height: 1.6;
  margin-bottom: 36rpx;
  text-align: justify;
}

.link {
  color: var(--primary, #CCFF00);
  font-weight: 500;
}

.privacy-btn {
  width: 100%;
  height: 88rpx;
  background: var(--primary, #CCFF00);
  color: #000000;
  border: none;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 800;
  margin-bottom: 16rpx;
  line-height: 88rpx;
}

.privacy-btn::after {
  border: none;
}

.privacy-cancel {
  width: 100%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #B0B0B0;
}
