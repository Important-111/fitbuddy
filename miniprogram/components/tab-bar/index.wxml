<view class="tab-bar">
  <view
    wx:for="{{tabs}}"
    wx:key="key"
    class="tab-item {{active === item.key ? 'active' : ''}}"
    bindtap="onTap"
    data-key="{{item.key}}"
    data-url="{{item.url}}"
  >
    <image
      class="tab-icon"
      src="{{active === item.key ? item.iconActive : item.icon}}"
      mode="aspectFit"
    ></image>
    <text class="tab-label">{{item.label}}</text>
  </view>
</view>
